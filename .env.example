# Copy this file to .env and fill in real values. Never commit the real .env
# file (it's gitignored). Nothing in this file should ever be a real secret --
# every value below is either a safe local-dev default or an obvious
# placeholder you must replace.

# --- Core Django ---
# Fake placeholder -- generate your own for anything beyond local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-your-own-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Africa/Algiers

# --- Database ---
# Leave DB_ENGINE=sqlite3 for local development (default, no setup needed).
# For MySQL/PostgreSQL in production, set DB_ENGINE to "mysql" or
# "postgresql" and fill in the rest.
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Media storage: Cloudflare R2 (S3-compatible) ---
# Leave all four blank to fall back to local filesystem storage in dev.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# --- GeoIP (Algeria write-restriction) ---
# Free MaxMind GeoLite2-Country database -- see README.md "GeoIP setup" for
# how to obtain it (requires a free MaxMind account, not included in the repo).
GEOIP_DB_PATH=../GeoLite2-Country.mmdb

# --- Cloudflare Turnstile (captcha) ---
# From your own Cloudflare dashboard -- see README.md.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- NSFWJS moderation sidecar (Wave 3) ---
NSFWJS_SIDECAR_URL=http://127.0.0.1:8801

# --- Anti-abuse ---
RATE_LIMIT_CREATIONS_PER_HOUR=20
